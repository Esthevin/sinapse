{
  "name": "sinapse",
  "version": "2.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "validar": "node scripts/validar-contenido.mjs",
    "audio:generar": "node scripts/generar-audios-voicestudio.mjs",
    "build:apk": "eas build --platform android --profile preview",
    "voces:generar": "node scripts/generar-voces-peruanas.mjs",
    "audio:importar": "node scripts/importar-audios.mjs",
    "catalogo:generar": "node scripts/generar-catalogo.mjs",
    "postinstall": "patch-package",
    "reparto": "node scripts/analizar-reparto.mjs",
    "pdf:audiolibro": "node --experimental-strip-types --no-warnings scripts/pdf-a-audiolibro.mjs",
    "audio:alinear": "node scripts/alinear-audio.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-audio": "~0.3.0",
    "expo-constants": "~17.0.0",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-sharing": "~13.0.1",
    "expo-speech": "~13.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.0",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "patch-package": "^8.0.1",
    "pdfjs-dist": "^3.11.174",
    "typescript": "~5.3.3"
