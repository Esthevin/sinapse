{
  "expo": {
    "name": "Sinapse",
    "slug": "sinapse",
    "version": "1.3.0",
    "orientation": "portrait",
    "scheme": "sinapse",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1B3A5B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.sinapse.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "pe.sinapse.app",
      "versionCode": 4
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Sinapse usa el micrófono para que los narradores graben historias con su voz."
        }
      ],
      "expo-asset",
      "expo-font"
    ]
  }
}
