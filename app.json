{
  "expo": {
    "name": "Sinapse",
    "slug": "sinapse",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "sinapse",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D1A16"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.sinapse.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "pe.sinapse.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D1A16"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Sinapse",
      "shortName": "Sinapse",
      "backgroundColor": "#F6F1E7",
      "themeColor": "#1D1A16"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Sinapse usa el micrófono para que los narradores graben historias con su voz."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "catalogUrl": "https://esthevin.github.io/sinapse/catalogo/catalogo.json"
    },
    "experiments": {
      "baseUrl": "/sinapse"
    },
    "icon": "./assets/icon.png"
  }
}
